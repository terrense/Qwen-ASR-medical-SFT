# Environments and model weights - reproducible from environment.txt + downloads
env_asr/
env_tts/
models/
pip_cache/

# Audio and large binaries - regenerated by the pipeline, never edited by hand
data/public/*_wav/
data/public/*.parquet
data/public/*.zip
data/public/aishell1_parquet/
data/smoke/
data/synthetic/**/*.wav
**/*.wav
**/*.tar.gz
**/*.tgz

# Checkpoints - large, regenerable, and pinned by config + seed
experiments/*/checkpoints/
experiments/**/checkpoints/

# Raw logs are noisy; the curated record lives in EXPERIMENT_STATUS.md
logs/*.log
nohup.out

__pycache__/
*.pyc
.ipynb_checkpoints/

# 仓库自身的备份副本,不入库
*.bundle
