# Environments and model weights - reproducible from environment.txt + downloads
env_asr/
env_tts/
models/
pip_cache/

# Audio and large binaries - regenerated by the pipeline, never edited by hand
data/public/*_wav/
data/public/*.parquet
data/public/*.zip
data/public/aishell1_parquet/
data/smoke/
data/synthetic/**/*.wav
**/*.wav
**/*.tar.gz
**/*.tgz

# Checkpoints - large, regenerable, and pinned by config + seed
experiments/*/checkpoints/
experiments/**/checkpoints/

# Full-test-set predictions are ~5.5 MB per run and every sweep adds seven of
# them. metrics.json carries the numbers; the predictions stay on the H20 for
# error analysis. The small pipeline_eval_* sets remain tracked.
experiments/**/test_*/predictions.jsonl

# Raw logs are noisy; the curated record lives in EXPERIMENT_STATUS.md
logs/*.log
nohup.out

__pycache__/
*.pyc
.ipynb_checkpoints/
data/public/rirs_noises/
